# ============================================================================
# MyMoney — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel
# (Project → Settings → Environment Variables). NUNCA commite o .env.local.
# ============================================================================

# Modo demonstração: dados fictícios, não chama nenhuma API (bom para testar a UI).
DEMO_MODE=false

# --- Login (gere com: npm run setup:auth) -----------------------------------
AUTH_SECRET=
AUTH_PASSWORD_HASH=
# Duração da sessão em dias
AUTH_SESSION_DAYS=30

# --- Fase 1: Binance (API Key SOMENTE LEITURA) -------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Fase 2: Pluggy / Santander via Open Finance (Meu Pluggy) ----------------
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_SANTANDER_ITEM_ID=

# --- Fase 3: XP (opcional: se vazio, usa o fallback do src/config/finance.ts) -
PLUGGY_XP_ITEM_ID=

# Token gratuito da brapi.dev (cotações B3). Sem token, só PETR4/VALE3/MGLU3/ITUB4 funcionam.
BRAPI_TOKEN=
